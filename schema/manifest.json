{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "MegaETH execution fixture release manifest 1.x",
  "description": "A release's cases, specs, shards, blobs and bound files, each by digest. The manifest digest (SHA-256 of its canonical bytes) is distributed outside it. Shard members, counts and order are checked as docs/versioning.md states.",
  "type": "object",
  "additionalProperties": false,
  "required": ["format", "schemaVersion", "suite", "schemas", "specs", "cases", "shards", "blobs", "files", "counts"],
  "properties": {
    "format": {"const": "mega-execution-manifest", "x-error": "unsupported-format"},
    "schemaVersion": {"type": "string", "pattern": "^1\\.(0|[1-9][0-9]*)$", "x-error": "unsupported-schema-version"},
    "suite": {
      "type": "object",
      "additionalProperties": false,
      "required": ["name", "version"],
      "properties": {
        "name": {"$ref": "common.json#/$defs/Name"},
        "version": {
          "description": "Semantic version of the suite release under its spec line.",
          "type": "string",
          "pattern": "^(0|[1-9][0-9]*)\\.(0|[1-9][0-9]*)\\.(0|[1-9][0-9]*)(-[A-Za-z0-9]+(\\.[A-Za-z0-9]+)*)?$",
          "x-error": "invalid-value"
        }
      }
    },
    "schemas": {
      "description": "Each schema file of the release by the SHA-256 of its bytes (schema files contain JSON numbers, so they are hashed as blobs, not as canonical JSON).",
      "type": "object",
      "propertyNames": {"$ref": "#/$defs/RelativePath"},
      "additionalProperties": {"$ref": "common.json#/$defs/Digest"}
    },
    "specs": {
      "description": "Every spec a case or schedule references, by descriptor digest.",
      "type": "object",
      "propertyNames": {"$ref": "common.json#/$defs/Digest"},
      "additionalProperties": {
        "type": "object",
        "additionalProperties": false,
        "required": ["name", "registry"],
        "properties": {
          "name": {"type": "string"},
          "registry": {"$ref": "common.json#/$defs/Digest"}
        }
      }
    },
    "cases": {
      "description": "Sorted by caseId, no duplicates.",
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["caseId", "profile", "requires", "path", "file", "semantic"],
        "properties": {
          "caseId": {"$ref": "common.json#/$defs/CaseId"},
          "profile": {"enum": ["state-transition", "transaction-validation", "block-import", "block-build", "stateless-block"], "x-error": "unknown-profile"},
          "requires": {"type": "array", "minItems": 1, "items": {"$ref": "fixture.json#/$defs/Requirement"}},
          "path": {"$ref": "#/$defs/RelativePath"},
          "file": {"$ref": "common.json#/$defs/Digest"},
          "semantic": {"$ref": "common.json#/$defs/Digest"}
        }
      }
    },
    "shards": {
      "description": "Named subsets (a required suite, nightly, proof shards): sorted case ids of this manifest.",
      "type": "object",
      "propertyNames": {"type": "string", "pattern": "^[a-z0-9-]+$", "x-error": "invalid-value"},
      "additionalProperties": {"type": "array", "items": {"$ref": "common.json#/$defs/CaseId"}}
    },
    "blobs": {
      "type": "object",
      "propertyNames": {"$ref": "common.json#/$defs/Digest"},
      "additionalProperties": {
        "type": "object",
        "additionalProperties": false,
        "required": ["size"],
        "properties": {"size": {"$ref": "common.json#/$defs/U64"}}
      }
    },
    "files": {
      "description": "Files the manifest binds: provenance and coverage reports.",
      "type": "object",
      "propertyNames": {"$ref": "#/$defs/RelativePath"},
      "additionalProperties": {"$ref": "common.json#/$defs/Digest"}
    },
    "counts": {
      "type": "object",
      "additionalProperties": false,
      "required": ["cases", "blobs"],
      "properties": {"cases": {"$ref": "common.json#/$defs/U64"}, "blobs": {"$ref": "common.json#/$defs/U64"}}
    }
  },
  "$defs": {
    "RelativePath": {
      "description": "A relative path inside the bundle: no leading slash, no empty, '.' or '..' segment.",
      "type": "string",
      "pattern": "^(?!.*(^|/)\\.{1,2}(/|$))[A-Za-z0-9._-]+(/[A-Za-z0-9._-]+)*$",
      "x-error": "invalid-value"
    }
  }
}
