{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "MegaETH execution fixture 1.x",
  "description": "One filled case: a concrete input, its spec, the observations a conforming implementation must produce, the rules they cover, and non-normative provenance. Unknown members are errors everywhere except inside provenance. docs/format.md states the meaning of every member; docs/canonical-json.md the encoding.",
  "type": "object",
  "additionalProperties": false,
  "required": ["format", "schemaVersion", "caseId", "specRef", "profile", "requires", "rules", "assertions", "input", "expected", "provenance"],
  "properties": {
    "format": {"const": "mega-execution-fixture", "x-error": "unsupported-format"},
    "schemaVersion": {
      "description": "major.minor; this schema reads major 1. A minor addition is used only behind a feature listed in requires.",
      "type": "string",
      "pattern": "^1\\.(0|[1-9][0-9]*)$",
      "x-error": "unsupported-schema-version"
    },
    "caseId": {"$ref": "common.json#/$defs/CaseId"},
    "specRef": {"$ref": "common.json#/$defs/SpecRef"},
    "profile": {
      "enum": ["state-transition", "transaction-validation", "block-import", "block-build", "stateless-block"],
      "x-error": "unknown-profile"
    },
    "requires": {
      "description": "Every observation group the expected result carries and every format feature the input uses, sorted, no duplicates; exactly those (docs/format.md, Requirements).",
      "type": "array",
      "minItems": 1,
      "items": {"$ref": "#/$defs/Requirement"}
    },
    "rules": {
      "description": "The rules the case covers, sorted, no duplicates; exactly the union of the assertions' rules.",
      "type": "array",
      "minItems": 1,
      "items": {"$ref": "common.json#/$defs/RuleRef"}
    },
    "assertions": {
      "type": "array",
      "minItems": 1,
      "items": {"$ref": "#/$defs/Assertion"}
    },
    "input": {"type": "object"},
    "expected": {"type": "object"},
    "provenance": {"$ref": "#/$defs/Provenance"}
  },
  "allOf": [
    {"if": {"properties": {"profile": {"const": "state-transition"}}}, "then": {"properties": {
      "input": {"$ref": "state-transition.json#/$defs/Input"},
      "expected": {"$ref": "state-transition.json#/$defs/Expected"}
    }}},
    {"if": {"properties": {"profile": {"const": "transaction-validation"}}}, "then": {"properties": {
      "input": {"$ref": "transaction-validation.json#/$defs/Input"},
      "expected": {"$ref": "transaction-validation.json#/$defs/Expected"}
    }}},
    {"if": {"properties": {"profile": {"const": "block-import"}}}, "then": {"properties": {
      "input": {"$ref": "block-import.json#/$defs/Input"},
      "expected": {"$ref": "block-import.json#/$defs/Expected"}
    }}},
    {"if": {"properties": {"profile": {"const": "block-build"}}}, "then": {"properties": {
      "input": {"$ref": "block-build.json#/$defs/Input"},
      "expected": {"$ref": "block-build.json#/$defs/Expected"}
    }}},
    {"if": {"properties": {"profile": {"const": "stateless-block"}}}, "then": {"properties": {
      "input": {"$ref": "stateless-block.json#/$defs/Input"},
      "expected": {"$ref": "stateless-block.json#/$defs/Expected"}
    }}}
  ],
  "$defs": {
    "Requirement": {
      "enum": [
        "feature:deposit",
        "feature:injected-faults",
        "feature:oracle-transcript",
        "feature:proof-attachment",
        "feature:raw-chain-config",
        "feature:salt",
        "feature:schedule",
        "feature:sparse-state",
        "feature:synthetic-transaction",
        "group:blocks",
        "group:checkpoints",
        "group:decisions",
        "group:detention",
        "group:gas-ledgers",
        "group:gas-pools",
        "group:limit",
        "group:limit-diagnostics",
        "group:limit-stop",
        "group:outcome",
        "group:reads",
        "group:receipts",
        "group:resources",
        "group:state",
        "group:validation",
        "group:witness"
      ],
      "x-error": "unknown-requirement"
    },
    "Assertion": {
      "description": "A JSON Pointer into expected and the rules the value there distinguishes.",
      "type": "object",
      "additionalProperties": false,
      "required": ["path", "rules"],
      "properties": {
        "path": {"type": "string", "pattern": "^/expected(/[^/]*)*$", "x-error": "unbound-assertion"},
        "rules": {"type": "array", "minItems": 1, "items": {"$ref": "common.json#/$defs/RuleRef"}}
      }
    },
    "Provenance": {
      "description": "Non-normative: not in the semantic digest, bound by the file digest. Open for extension.",
      "type": "object",
      "required": ["status"],
      "properties": {
        "status": {"enum": ["example", "candidate", "approved", "superseded"], "x-error": "invalid-value"}
      }
    }
  }
}
