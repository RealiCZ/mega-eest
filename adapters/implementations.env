# The two Satin implementations the adapters run, each pinned by commit.
#
# Implementation (a), revm-based: a cargo git dependency of adapters/revm (see its Cargo.toml,
# which repeats this revision).
REVM_IMPL_REPO=https://github.com/megaeth-labs/mega-evm
REVM_IMPL_REV=5e3f30ad4692f3815105dea1368f789f032ddd2b

# Implementation (b), evm2-based: the next/ workspace of this mega-evm revision, with the evm2
# fork that revision pins in next/evm2-fork.env. Its crates find evm2 by the relative path
# ../../evm2, so tools/fetch-implementations.sh checks both out side by side under vendor/.
EVM2_IMPL_REPO=https://github.com/RealiCZ/mega-evm
EVM2_IMPL_REV=f3d84454a0deea0129fe44bb1278677698680789
EVM2_FORK_REPO=https://github.com/RealiCZ/evm2
EVM2_FORK_REV=390a387657912efd631cb5cc272cc7d076e625e9
